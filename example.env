# Versão do UniFi OS Server
UOS_SERVER_VERSION=5.0.6

# URLs oficiais de download do instalador (fw-download.ubnt.com)
# Defina pelo menos uma, de acordo com a arquitetura do host.
INSTALLER_URL_AMD64=https://fw-download.ubnt.com/data/unifi-os-server/REPLACE_ME
INSTALLER_URL_ARM64=

# IP público/do host usado pelo UniFi (obrigatório)
UOS_SYSTEM_IP=REPLACE_WITH_HOST_IP

# Timezone do container
TZ=America/Sao_Paulo

# Expõe a Network App direto na porta 7443, pulando o SSO do UOS.
# Usado para debug/acesso direto à API. NUNCA usar em produção.
EXPOSE_NETWORK_APP=false

# false = usa o MongoDB externo (serviço unifi-os-server-mongodb)
# true  = deixa a UniFi Network App gerenciar seu próprio mongod interno
MONGO_INTERNAL=false

# Caminho único de persistência (config, MongoDB, dados do UniFi, etc.)
DATA_PATH=./unifi-data
